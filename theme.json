{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": false,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "palette": [
        { "slug": "black", "color": "#000000", "name": "Black" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" },
        { "slug": "gray-100", "color": "#F5F5F5", "name": "Gray 100" },
        { "slug": "gray-300", "color": "#D4D4D4", "name": "Gray 300" },
        { "slug": "gray-500", "color": "#737373", "name": "Gray 500" },
        { "slug": "gray-700", "color": "#404040", "name": "Gray 700" },
        { "slug": "gray-900", "color": "#171717", "name": "Gray 900" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md",
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": false,
      "padding": true,
      "spacingSizes": [
        { "slug": "xs", "size": "0.5rem", "name": "XS" },
        { "slug": "sm", "size": "0.75rem", "name": "SM" },
        { "slug": "md", "size": "1.5rem", "name": "MD" },
        { "slug": "lg", "size": "2.5rem", "name": "LG" },
        { "slug": "xl", "size": "4rem", "name": "XL" },
        { "slug": "2xl", "size": "6rem", "name": "2XL" },
        { "slug": "3xl", "size": "8rem", "name": "3XL" }
      ],
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "slug": "primary",
          "name": "Primary"
        },
        {
          "fontFamily": "Georgia, \"Times New Roman\", serif",
          "slug": "secondary",
          "name": "Secondary"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.75rem", "name": "XS" },
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "clamp(1.75rem, 3vw, 2.5rem)", "name": "X Large" },
        { "slug": "xx-large", "size": "clamp(2.25rem, 5vw, 4rem)", "name": "XX Large" },
        { "slug": "display", "size": "clamp(3rem, 7vw, 6rem)", "name": "Display" }
      ],
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "textDecoration": false,
      "textTransform": false
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        },
        "color": {
          "custom": false,
          "customGradient": false,
          "defaultGradients": false
        },
        "spacing": {
          "customSpacingSize": false
        },
        "typography": {
          "customFontSize": false,
          "fontStyle": false,
          "fontWeight": false,
          "letterSpacing": false,
          "textDecoration": false,
          "textTransform": false
        }
      },
      "core/heading": {
        "color": {
          "custom": false,
          "customGradient": false
        },
        "typography": {
          "customFontSize": false,
          "fontStyle": false,
          "fontWeight": false,
          "letterSpacing": false,
          "textDecoration": false,
          "textTransform": false
        }
      },
      "core/paragraph": {
        "color": {
          "custom": false,
          "customGradient": false
        },
        "typography": {
          "customFontSize": false,
          "fontStyle": false,
          "fontWeight": false,
          "letterSpacing": false,
          "textDecoration": false,
          "textTransform": false
        }
      },
      "core/navigation": {
        "color": {
          "custom": false,
          "customGradient": false
        },
        "typography": {
          "customFontSize": false,
          "fontStyle": false,
          "fontWeight": false
        }
      },
      "core/image": {
        "color": {
          "custom": false,
          "customGradient": false
        }
      },
      "core/quote": {
        "color": {
          "custom": false,
          "customGradient": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|black"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md",
      "padding": {
        "left": "var:preset|spacing|md",
        "right": "var:preset|spacing|md"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var:preset|color|black",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|black"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "600",
          "lineHeight": "1.1"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "link": {
        "color": {
          "text": "currentColor"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/separator": {
        "color": {
          "background": "var:preset|color|gray-300"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|black",
            "style": "solid",
            "width": "2px"
          }
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|md"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "blank", "title": "Blank", "postTypes": ["page"] }
  ]
}